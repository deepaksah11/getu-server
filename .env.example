# Server Network Configuration
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Database & Storage Adapter
# Options: 'file' (uses local ./data/db.json) | 'supabase' (uses PostgreSQL)
DATA_STORE=file

# Supabase Credentials (Required only if DATA_STORE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Automation Engine Settings
# Options: 'dry-run' (scans, fills, prepares application without clicking final submit) | 'production' (submits live)
AUTOMATION_MODE=dry-run

# AI Provider Settings
# Options: 'offline' (deterministic fast rule-based engine, no API key needed) | 'gemini' (Google Gemini AI)
AI_ENGINE=offline
GEMINI_API_KEY=

# Logging Level
# Options: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info
